{
 "title": "Tool call history",
 "kicker": "tool-call-history",
 "mascots": [
  "claude",
  "codex"
 ],
 "lines": [
  {
   "id": "hook",
   "min": 8,
   "hed": [
    "The task says",
    "done."
   ],
   "sub": "But what ran?",
   "log": "> task: done",
   "text": "The task says done. But what did the agent actually run along the way?",
   "scene": [
    {
     "k": "card",
     "dot": "g",
     "title": "Update the config",
     "sub": "Claude Code",
     "chip": [
      "Done",
      "g"
     ],
     "at": 1.2
    },
    {
     "k": "msg",
     "from": "agent",
     "who": "System",
     "text": "...but what did it run?",
     "at": 3
    }
   ],
   "mascot": {
    "claude": "done",
    "codex": "ask"
   }
  },
  {
   "id": "gap",
   "min": 8,
   "hed": [
    "You see the",
    "result only."
   ],
   "sub": "Not the path.",
   "log": "> path: unknown",
   "text": "Most tools show you the result. The path the agent took to get there stays hidden.",
   "scene": [
    {
     "k": "big",
     "text": "The result.|Not the path.",
     "sub": "a blind spot",
     "at": 1.4
    }
   ]
  },
  {
   "id": "idea",
   "min": 8,
   "hed": [
    "Keep the",
    "full run."
   ],
   "sub": "A trajectory.",
   "log": "> trajectory: on",
   "text": "Agent R Q keeps the whole run, as a trajectory you can open on any task.",
   "scene": [
    {
     "k": "card",
     "dot": "b",
     "title": "Trajectory",
     "sub": "Every tool call and message",
     "chip": [
      "Tab",
      "b"
     ],
     "at": 1.2
    },
    {
     "k": "kbd",
     "keys": [
      "Trajectory"
     ],
     "label": "open it on any task",
     "at": 3
    }
   ]
  },
  {
   "id": "lanes",
   "min": 8,
   "hed": [
    "Grouped",
    "in lanes."
   ],
   "sub": "In order.",
   "log": "> lanes: ordered",
   "text": "The Trajectory tab lists every tool call and message in the run, grouped into lanes.",
   "scene": [
    {
     "k": "card",
     "dot": "g",
     "title": "Read  ·  config.yaml",
