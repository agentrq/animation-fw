    {
     "k": "btns",
     "chip": [
      "Bash",
      "y"
     ],
     "code": "Bash  rm -rf build/",
     "buttons": [
      "Allow",
      "Deny"
     ],
     "press": 1,
     "tap": 4,
     "at": 1.4
    }
   ]
  },
  {
   "id": "denied",
   "min": 8,
   "hed": [
    "Denied calls",
    "show up too."
   ],
   "sub": "Nothing hidden.",
   "log": "> denied: kept",
   "text": "Denied calls are kept too, so you also see what the agent tried, and was stopped from doing.",
   "scene": [
    {
     "k": "card",
     "dot": "r",
     "title": "Bash  ·  rm -rf build/",
     "sub": "Denied by Maya",
     "chip": [
      "Denied",
      "r"
     ],
     "at": 1.2
    },
    {
     "k": "card",
     "dot": "g",
     "title": "Edit  ·  config.yaml",
     "sub": "Allowed",
     "chip": [
      "Allowed",
      "g"
     ],
     "at": 2.8
    }
   ]
  },
  {
   "id": "debug",
   "min": 8,
   "hed": [
    "Debug with",
    "facts."
   ],
   "sub": "Replay the steps.",
   "log": "> debug: replay",
