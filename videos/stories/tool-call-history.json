     "chip": [
      "Allowed",
      "g"
     ],
     "at": 1.2
    },
    {
     "k": "card",
     "dot": "g",
     "title": "Edit  ·  config.yaml",
     "sub": "Allowed",
     "chip": [
      "Allowed",
      "g"
     ],
     "at": 2.8
    },
    {
     "k": "card",
     "dot": "r",
     "title": "Bash  ·  rm -rf build/",
     "sub": "Denied by you",
     "chip": [
      "Denied",
      "r"
     ],
     "at": 4.4
    }
   ]
  },
  {
   "id": "search",
   "min": 8,
   "hed": [
    "Fully",
    "searchable."
   ],
   "sub": "Find any call.",
   "log": "> search: bash",
   "text": "And it is searchable, so you can find every bash command in a long run without scrolling.",
   "scene": [
    {
     "k": "kbd",
     "keys": [
      "Bash"
     ],
     "label": "search the trajectory",
     "at": 1.4
    },
    {
     "k": "card",
     "dot": "y",
     "title": "Bash  ·  rm -rf build/",
     "sub": "Matches your search",
     "chip": [
      "Match",
      "y"
     ],
     "at": 3.2
    }
   ]
  },
  {
   "id": "detail",
   "min": 8,
   "hed": [
    "Click for",
    "the details."
   ],
   "sub": "Exact input.",
   "log": "> entry: bash",
   "text": "Click any entry to see exactly what ran, and whether it was allowed or denied.",
   "scene": [
    {
     "k": "term",
     "lines": [
      [
       "tool: Bash",
       "g"
      ],
      [
       "input: rm -rf build/",
       "p"
      ],
      [
       "decision: denied by Maya, 10:51",
       "r"
      ]
     ],
     "at": 1.4
    }
   ]
  },
  {
   "id": "approve",
   "min": 8,
   "hed": [
