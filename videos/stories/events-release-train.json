    },
    {
     "k": "flow",
     "nodes": [
      [
       "Build",
       "built"
      ],
      [
       "Docs",
       "Gemini"
      ]
     ],
     "at": 3.2
    }
   ],
   "mascot": {
    "codex": "work",
    "agy": "work"
   }
  },
  {
   "id": "guard",
   "min": 5,
   "hed": [
    "You stay",
    "in control."
   ],
   "sub": "Approvals still apply.",
   "log": "> deploy: push to main?",
   "text": "You stay in control. Deploy keeps its approval, so the train never ships without a human saying yes.",
