   "min": 5,
   "hed": [
    "Finish with",
    "a signal."
   ],
   "sub": "The agent just reports.",
   "log": "> build emits built",
   "text": "Build completes and emits built. Test completes and emits tested. The agent calls nothing, it only reports what happened.",
   "scene": [
    {
     "k": "flow",
     "nodes": [
      [
       "Build",
       "emits built"
      ],
      [
       "Test",
       "emits tested"
      ],
      [
       "Deploy",
       "emits shipped"
      ]
     ],
     "at": 1.4
    }
   ],
   "mascot": {
    "claude": "done"
   }
  },
  {
   "id": "wire",
   "min": 5,
   "hed": [
    "Wire it to",
    "a workspace."
   ],
   "sub": "No glue code.",
   "log": "> built -> Test workspace",
   "text": "Wire each event to the next workspace, and the next task appears on its own. No glue code at all.",
   "scene": [
    {
     "k": "flow",
     "nodes": [
      [
       "Build workspace",
       "built"
      ],
      [
       "Test workspace",
