 ],
 "lines": [
  {
   "id": "hook",
   "min": 5,
   "hed": [
    "Four agents,",
    "one release."
   ],
   "sub": "A human nudges each.",
   "log": "> release: 4 handoffs",
   "text": "Shipping a release means build, then test, then docs, then deploy. Four agents, and a human nudging every single one.",
   "scene": [
    {
     "k": "card",
     "dot": "g",
     "title": "Build",
     "sub": "Claude Code",
     "chip": [
      "Done",
      "g"
     ],
     "at": 1
    },
    {
     "k": "card",
     "dot": "z",
     "title": "Test",
     "sub": "Codex",
     "chip": [
      "Waiting",
      "z"
     ],
     "at": 2.2
    },
    {
     "k": "card",
     "dot": "z",
     "title": "Docs",
     "sub": "Gemini",
     "chip": [
      "Waiting",
      "z"
     ],
     "at": 3.4
    },
    {
     "k": "card",
     "dot": "z",
     "title": "Deploy",
     "sub": "Cursor",
     "chip": [
      "Waiting",
      "z"
     ],
     "at": 4.6
    }
   ],
   "mascot": {
    "claude": "done",
    "codex": "ask"
   }
  },
  {
   "id": "cost",
   "min": 5,
   "hed": [
    "Every handoff",
    "waits for you."
   ],
   "sub": "Copy, paste, repeat.",
   "log": "> you: start the next task",
   "text": "Each handoff waits for you. You check the board, copy the context, and start the next task by hand.",
   "scene": [
    {
     "k": "term",
     "lines": [
      [
       "> check the board",
       "r"
      ],
      [
       "> copy the context",
       "r"
      ],
      [
       "> start the next task",
       "r"
      ]
     ],
     "at": 1.4
    }
   ],
   "mascot": {
    "codex": "ask"
   }
  },
  {
   "id": "idea",
   "min": 5,
   "hed": [
    "Events fix",
    "the gap."
   ],
   "sub": "A named signal.",
   "log": "> event: built",
   "text": "Agent R Q events fix that. An event is a named signal that a task sends the moment it finishes.",
   "scene": [
    {
     "k": "big",
     "text": "built",
     "sub": "a named signal",
     "at": 1.4
    }
   ]
  },
  {
