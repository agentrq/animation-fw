    {
     "k": "flow",
     "nodes": [
      [
       "docs",
       "yolo on"
      ],
      [
       "web",
       "asks"
      ],
      [
       "billing",
       "never"
      ]
     ],
     "at": 1.4
    }
   ]
  },
  {
   "id": "rule",
   "min": 8,
   "hed": [
    "A good",
    "rule."
   ],
   "sub": "Keep risk apart.",
   "log": "> separate the risky",
   "text": "Keep risky work in a workspace or task that never has YOLO. Then a slip of the finger cannot reach it.",
   "scene": [
    {
     "k": "big",
     "text": "Keep risk|in its own room.",
     "at": 1.4
    }
   ]
  },
  {
   "id": "record",
   "min": 8,
   "hed": [
    "Still on the",
    "record."
   ],
   "sub": "Every call is logged.",
   "log": "> trajectory: all calls",
   "text": "Even with YOLO on, every call stays in the tool call history, so you can check afterwards.",
   "scene": [
    {
     "k": "card",
     "dot": "b",
     "title": "Trajectory",
     "sub": "Every call logged",
     "chip": [
      "Visible",
      "b"
     ],
     "at": 1.4
    },
    {
     "k": "term",
     "lines": [
      [
       "Read   auto-approved",
       "p"
      ],
      [
       "Edit   auto-approved",
       "p"
      ]
     ],
     "at": 3.2
    }
   ]
  },
  {
   "id": "review",
   "min": 8,
   "hed": [
    "Check the",
    "trail."
   ],
   "sub": "Spot surprises early.",
   "log": "> review history",
   "text": "Skim the history after a run. If something looks odd, you catch it while it is still small.",
   "scene": [
    {
     "k": "bar",
     "segs": [
      [
       "Read",
       35,
       "g"
      ],
      [
       "Edit",
       50,
       "g"
      ],
      [
