     "who": "Agent",
     "text": "Asking before the next step.",
     "at": 3.2
    }
   ],
   "mascot": {
    "agy": "ask"
   }
  },
  {
   "id": "trust",
   "min": 8,
   "hed": [
    "Trust is",
    "earned."
