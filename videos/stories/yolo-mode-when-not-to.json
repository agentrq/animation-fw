{
 "title": "YOLO: when not to",
 "kicker": "yolo mode when not to",
 "mascots": [
  "claude",
  "codex",
  "agy"
 ],
 "lines": [
  {
   "id": "hook",
   "min": 8,
   "hed": [
    "Not for",
    "everything."
   ],
   "sub": "Auto approval has limits.",
   "log": "> yolo: wonderful, not universal",
   "text": "Auto approval is wonderful for safe, repetitive work. But it is not a switch for the whole world.",
   "scene": [
    {
     "k": "card",
     "dot": "g",
     "title": "Format all files",
     "sub": "YOLO on",
     "chip": [
      "Safe",
      "g"
     ],
     "at": 1.4
    },
    {
     "k": "card",
     "dot": "y",
     "title": "Everything else?",
     "sub": "Think twice",
     "chip": [
      "Careful",
      "y"
     ],
     "at": 3
    }
   ],
   "mascot": {
    "claude": "work"
   }
  },
  {
   "id": "safe",
   "min": 8,
   "hed": [
    "Safe work",
    "is fine."
   ],
   "sub": "Undoable and local.",
   "log": "> formatting, lint, docs",
   "text": "Formatting, lint fixes and docs edits are fine. They are local, and you can undo them in one command.",
   "scene": [
    {
     "k": "card",
     "dot": "g",
     "title": "Format all files",
     "sub": "Undo with git",
     "chip": [
      "Safe",
      "g"
     ],
     "at": 1.2
    },
    {
     "k": "card",
     "dot": "g",
     "title": "Fix lint errors",
     "sub": "Undo with git",
     "chip": [
      "Safe",
      "g"
     ],
     "at": 2.6
    },
    {
     "k": "card",
     "dot": "g",
     "title": "Update the docs",
     "sub": "Undo with git",
     "chip": [
      "Safe",
      "g"
     ],
     "at": 4
    }
   ]
  },
  {
   "id": "risky",
   "min": 8,
   "hed": [
    "Risky work",
    "is not."
   ],
   "sub": "Some things can not be undone.",
   "log": "> deploy, delete, pay",
   "text": "Deploys, deletes and anything with money are different. A wrong call there cannot be taken back.",
   "scene": [
    {
     "k": "card",
     "dot": "r",
     "title": "Deploy to production",
     "sub": "Cannot be undone",
     "chip": [
      "Risky",
      "r"
     ],
     "at": 1.2
    },
    {
     "k": "card",
     "dot": "r",
     "title": "Drop the old table",
     "sub": "Cannot be undone",
     "chip": [
      "Risky",
      "r"
     ],
     "at": 2.6
    },
    {
     "k": "card",
     "dot": "r",
     "title": "Refund a customer",
     "sub": "Cannot be undone",
     "chip": [
      "Risky",
      "r"
     ],
     "at": 4
    }
   ],
   "mascot": {
    "codex": "alert"
   }
  },
  {
   "id": "ask",
   "min": 8,
   "hed": [
    "Keep the",
    "question."
