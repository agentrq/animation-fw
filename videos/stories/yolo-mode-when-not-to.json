    {
     "k": "btns",
     "chip": [
      "Authorization required",
      "y"
     ],
     "code": "Bash  git push origin main",
     "buttons": [
      "Allow Once",
      "Deny"
     ],
     "press": 1,
     "tap": 5,
     "at": 1.4
    }
   ],
   "mascot": {
    "codex": "ask"
   }
  },
  {
   "id": "task",
   "min": 8,
   "hed": [
    "Set it",
    "per task."
   ],
   "sub": "A narrow switch.",
   "log": "> yolo: per task",
   "text": "So YOLO is set per task. The lint sweep gets it, and the deploy task does not.",
   "scene": [
    {
     "k": "card",
     "dot": "g",
     "title": "Lint sweep",
     "sub": "YOLO on",
     "chip": [
      "Auto",
      "g"
     ],
     "at": 1.4
    },
    {
     "k": "card",
     "dot": "y",
     "title": "Deploy to production",
     "sub": "YOLO off, asks first",
     "chip": [
      "Asks",
      "y"
     ],
     "at": 3
    }
   ]
  },
  {
   "id": "ws",
   "min": 8,
   "hed": [
    "Or per",
    "workspace."
   ],
   "sub": "A wide switch.",
   "log": "> yolo: per workspace",
   "text": "Or set it per workspace. A docs workspace can run free, and a billing workspace never does.",
