       15,
       "r"
      ]
     ],
     "at": 1.4
    }
   ],
   "mascot": {
    "claude": "done"
   }
  },
  {
   "id": "stop",
   "min": 8,
   "hed": [
    "You can stop",
    "it."
   ],
   "sub": "Switch off any time.",
   "log": "> yolo: off",
   "text": "And if a task starts to feel risky, switch YOLO off in the middle, and the questions return at once.",
   "scene": [
    {
     "k": "card",
     "dot": "y",
     "title": "Migrate the data",
     "sub": "YOLO off",
     "chip": [
      "Asks",
      "y"
