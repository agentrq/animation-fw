     "at": 1.2
    },
    {
     "k": "card",
     "dot": "b",
     "title": "Platform team",
     "sub": "You are a member",
     "chip": [
      "Member",
      "b"
     ],
     "at": 3
    }
   ]
  },
  {
   "id": "pick",
   "min": 8,
   "hed": [
    "Pick a",
    "workspace."
