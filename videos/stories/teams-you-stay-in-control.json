     "at": 2.8
    },
    {
     "k": "card",
     "dot": "z",
     "title": "Finance",
     "sub": "Not picked",
     "chip": [
      "Private",
      "z"
     ],
     "at": 4.4
    }
   ]
  },
  {
   "id": "switch",
   "min": 8,
   "hed": [
    "Three switches",
    "per workspace."
