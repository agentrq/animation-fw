    },
    {
     "k": "card",
     "dot": "z",
     "title": "Skills",
     "sub": "Held back from the team",
     "chip": [
      "Off",
      "z"
     ],
     "at": 4.4
    }
   ]
  },
  {
   "id": "tasks",
   "min": 8,
   "hed": [
    "Tasks are",
    "read only."
