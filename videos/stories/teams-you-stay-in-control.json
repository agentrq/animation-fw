     "at": 1.4
    },
    {
     "k": "card",
     "dot": "g",
     "title": "Memory",
     "sub": "Shared, read-only",
     "chip": [
      "Read",
      "g"
     ],
     "at": 3.2
    }
   ],
   "mascot": {
    "claude": "work"
   }
  },
