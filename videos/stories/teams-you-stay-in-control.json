 "lines": [
  {
   "id": "hook",
   "min": 8,
   "hed": [
    "Join a team,",
    "share it all?"
   ],
   "sub": "A fair worry.",
   "log": "> team: join?",
   "text": "Joining a team sounds risky. Will everyone now see all my tasks, my notes, and my private docs?",
   "scene": [
    {
     "k": "msg",
     "from": "user",
     "who": "You",
     "text": "Wait, will they see my private stuff?",
     "at": 1.4
    },
    {
     "k": "card",
     "dot": "y",
     "title": "Private tasks, notes, docs",
     "sub": "Everything?",
     "chip": [
      "Worried",
      "y"
     ],
     "at": 3.2
    }
   ],
   "mascot": {
    "codex": "ask"
   }
  },
  {
   "id": "nothing",
   "min": 8,
   "hed": [
    "Joined.",
    "Shared: nothing."
   ],
   "sub": "Not by default.",
   "log": "> shared: 0",
   "text": "The answer is no. Nothing is shared just because you joined, and everyone keeps their own account.",
   "scene": [
    {
     "k": "big",
     "text": "Joined.|Shared: nothing.",
     "sub": "you decide, one by one",
     "at": 1.4
    }
   ]
  },
